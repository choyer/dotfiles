#!/usr/bin/env bash
# chezmoi:run_onchange_after
#
# Installs Omarchy AUR packages via yay (Omarchy's bundled AUR helper).
# This is a chezmoi run_onchange_after_ script, so chezmoi hashes the
# fully-rendered contents below and only re-runs it when that hash changes
# -- i.e. whenever you edit the AUR_PACKAGES list.
#
# ---------------------------------------------------------------------------
# Define your AUR packages here. One package name per line.
# ---------------------------------------------------------------------------
AUR_PACKAGES=(
  "hyprmoncfg"
  "tty-clock"
)

set -uo pipefail

# Define Colors
NC='\e[0m' # No Color (Reset)
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'

echo -e "\n====== ${GREEN}AUR Package Installation${NC} ======"

{{ if ne .chezmoi.os "linux" -}}
echo -e "Omarchy AUR: ${YELLOW}skipping${NC}, not running on Linux ({{ .chezmoi.os }})."
exit 0
{{ end -}}

if [ "${#AUR_PACKAGES[@]}" -eq 0 ]; then
  echo -e "Omarchy AUR: ${YELLOW}no packages defined${NC}, skipping."
  exit 0
fi

if ! command -v yay >/dev/null 2>&1; then
  echo -e "Omarchy AUR: ${RED}'yay' command not found${NC}, skipping (not an Omarchy install?)." >&2
  exit 0
fi

cat <<'EOF'

============================================================================
 ⧎ AUR PACKAGE INSTALL WARNING ⧎
============================================================================
The Arch User Repository (AUR) is community-maintained and NOT reviewed by
Arch or Omarchy. Packages can contain arbitrary build scripts (PKGBUILDs)
that run with your user permissions during install. Only proceed if you
recognize and trust every package below.

The following packages are queued for install:
EOF
printf '  - %b%s\n' "$BLUE" "${AUR_PACKAGES[@]}"
echo -e "${NC}"

# Only prompt when attached to an interactive terminal. In a non-interactive
# chezmoi run (e.g. CI, scripted bootstrap) there's no one to answer, so skip
# the AUR install rather than guess, and let the rest of chezmoi continue.
if [ ! -t 0 ]; then
  echo -e "Omarchy AUR: ${RED}no interactive terminal detected, skipping AUR install.${NC}" >&2
  echo -e "Omarchy AUR: ${YELLOW}re-run 'chezmoi apply' from an interactive shell to install these packages.${NC}" >&2
  exit 0
fi

read -r -p "Proceed with installing these AUR packages? [y/N] " reply < /dev/tty || reply="n"
case "${reply}" in
  [yY]|[yY][eE][sS])
    ;;
  *)
    echo -e "Omarchy AUR: ${RED}cancelled by user, skipping AUR install.${NC}"
    exit 0
    ;;
esac

fail_count=0

for pkg in "${AUR_PACKAGES[@]}"; do
  if pacman -Qi "${pkg}" >/dev/null 2>&1; then
    echo -e "Omarchy AUR: ${YELLOW}${pkg} already installed, skipping.${NC}"
    continue
  fi

  echo "Omarchy AUR: installing ${pkg}..."
  if yay -S --needed --noconfirm "${pkg}"; then
    echo -e "Omarchy AUR: ${GREEN}${pkg} installed.${NC}"
  else
    status=$?
    echo -e "Omarchy AUR: ${RED}failed to install ${pkg}${NC} (exit ${status})." >&2
    fail_count=$((fail_count + 1))
  fi
done

if [ "${fail_count}" -gt 0 ]; then
  echo -e "Omarchy AUR: ${YELLOW}${fail_count}${NC} package(s) ${RED}failed to install.${NC}" >&2
  # Don't block the rest of chezmoi's run over an AUR package failure.
  exit 0
fi

echo -e "Omarchy AUR: ${GREEN}done.${NC}"
