#!/usr/bin/env bash
# chezmoi:run_onchange_after
#
# Installs Omarchy Arch packages via pacman (official repositories).
# This is a chezmoi run_onchange_after_ script, so chezmoi hashes the
# fully-rendered contents below and only re-runs it when that hash changes
# -- i.e. whenever you edit the PACMAN_PACKAGES list.
#
# ---------------------------------------------------------------------------
# Define your packages here. One package name per line.
# ---------------------------------------------------------------------------
PACMAN_PACKAGES=(
  "1password"
  "1password-cli"
  "doggo"
  "fx"
  "git-delta"
  "git-lfs"
  "readline"
)

set -uo pipefail

# Define Colors
NC='\e[0m' # No Color (Reset)
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'

echo -e "\n====== ${GREEN}Omarchy Package Installation${NC} ======"

{{ if ne .chezmoi.os "linux" -}}
echo -e "omarchy pkg: ${YELLOW}skipping${NC}, not running on Linux ({{ .chezmoi.os }})."
exit 0
{{ end -}}

if [ "${#PACMAN_PACKAGES[@]}" -eq 0 ]; then
  echo -e "omarchy pkg: ${YELLOW}no packages defined${NC}, skipping."
  exit 0
fi

if ! command -v pacman >/dev/null 2>&1; then
  echo -e "omarchy pkg: {$RED}'pacman' command not found${NC}, skipping (not an Omarchy install?)." >&2
  exit 0
fi

fail_count=0

for pkg in "${PACMAN_PACKAGES[@]}"; do
  echo "omarchy pkg: installing ${pkg}..."
  if sudo pacman -S --needed --noconfirm "${pkg}"; then
    echo -e "omarchy pkg: ${BLUE}${pkg} ${GREEN}installed.${NC}"
  else
    status=$?
    echo -e "omarchy pkg: ${RED}failed to install ${pkg} (exit ${status}).${NC}" >&2
    fail_count=$((fail_count + 1))
  fi
done

if [ "${fail_count}" -gt 0 ]; then
  echo -e "omarchy pkg: ${YELLOW}${fail_count}${NC} package(s) ${RED}failed to install.{$NC}" >&2
  # Don't block the rest of chezmoi's run over a package failure.
  exit 0
fi

echo -e "omarchy pkg: ${GREEN}done.${NC}"
