#!/usr/bin/env bash
# chezmoi:run_onchange_after
#
# Installs and (optionally) enables Omarchy 4.x plugins via the built-in
# `omarchy plugin` command. This is a chezmoi run_onchange_after_ script,
# so chezmoi hashes the fully-rendered contents below and only re-runs it
# when that hash changes -- i.e. whenever you edit the PLUGINS list.
#
# ---------------------------------------------------------------------------
# Define your plugins here. One entry per line, pipe-delimited:
#   "<github-repo-url>|<enable: true|false>"
# ---------------------------------------------------------------------------
PLUGINS=(
  "https://github.com/crmne/omarchy-hyprmoncfg|true"
  "https://github.com/sspaeti/omarchy-timezones-plugin|true"
  "https://github.com/crmne/omarchy-mpris.git|true"
  "https://github.com/lgse/sandman.git|true"
)

set -uo pipefail

# Define Colors
NC='\e[0m' # No Color (Reset)
RED='\e[31m'
GREEN='\e[32m'
YELLOW='\e[33m'
BLUE='\e[34m'

echo -e "\n====== ${GREEN}Omarchy Plugin Installation${NC} ======"

{{ if ne .chezmoi.os "linux" -}}
echo -e "omarchy plugins: ${YELLOW}skipping${NC}, not running on Linux ({{ .chezmoi.os }})."
exit 0
{{ end -}}

if ! command -v omarchy >/dev/null 2>&1; then
  echo -e "omarchy plugins: ${RED}'omarchy' command not found${NC}, skipping (not an Omarchy install?)." >&2
  exit 0
fi

fail_count=0

for entry in "${PLUGINS[@]}"; do
  repo="${entry%%|*}"
  enable="${entry##*|}"

  args=(plugin add "$repo" --yes)
  if [ "$enable" = "true" ]; then
    args+=(--enable)
  fi

  echo -e "omarchy plugins: ${BLUE}installing ${YELLOW}${repo}${NC} (enable=${enable})..."

  if output=$(omarchy "${args[@]}" 2>&1); then
    echo "${output}"
  else
    status=$?
    if echo "${output}" | grep -qi "already"; then
      echo -e "omarchy plugins: ${repo} already installed, ${YELLOW}skipping.${NC}"
    else
      echo -e "omarchy plugins: ${RED}failed to install ${repo}${NC} (exit ${status}):" >&2
      echo "${output}" >&2
      fail_count=$((fail_count + 1))
    fi
  fi
done

if [ "${fail_count}" -gt 0 ]; then
  echo -e "omarchy plugins: ${YELLOW}${fail_count}${NC} plugin(s) ${RED}failed to install.${NC}" >&2
  exit 1
fi

echo -e "omarchy plugins: ${GREEN}done.${NC}"
